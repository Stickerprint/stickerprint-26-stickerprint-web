# Supabase — progetto esistente (Dashboard → Project Settings → API)
PUBLIC_SUPABASE_URL=https://nhiwiwubecumxuknwxto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SITE_URL=https://stickerprint.it
# Chiave di servizio (Project Settings → API → service_role): SOLO lato server. Serve per gli ordini degli ospiti.
SUPABASE_SERVICE_ROLE_KEY=

# Postmark (Server → API Tokens)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM="Stickerprint <noreply@stickerprint.it>"
POSTMARK_MESSAGE_STREAM=outbound
OWNER_NOTIFY_EMAIL=info@stickerprint.it

# Chiave condivisa per chiamare /api/send-email da sistemi interni (openssl rand -hex 32)
INTERNAL_API_KEY=

# Instagram Graph API (account Business/Creator collegato a una Pagina Facebook)
# Token a lunga durata (60 giorni, rinnovabile) e ID utente Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=


# Notifiche push nuovi ordini (chiavi VAPID: node -e "console.log(require('web-push').generateVAPIDKeys())")
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@stickerprint.it

# Dashboard PERIZ Marketing (sezione Marketing dell'area amministratore).
# La chiave si crea dalla dashboard PERIZ, scheda Collegamenti del brand Stickerprint:
# vale solo per il nostro brand e si vede in chiaro una volta sola. SOLO lato server.
PERIZ_API_URL=https://dashboard.perizmarketing.it
PERIZ_API_KEY=
# Corrieri (Setup → Corrieri): senza credenziali si usano etichette e manifest interni
GLS_SEDE=
GLS_CODICE_CLIENTE=
GLS_PASSWORD=
GLS_CODICE_CONTRATTO=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_SANDBOX=1
TNT_COMPANY=
TNT_PASSWORD=
TNT_ACCOUNT=

# Google Analytics 4 (Marketing → Google Analytics): account di servizio con accesso Lettore alla proprietà
GA4_PROPERTY_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# TikTok Ads (Marketing → TikTok Ads): app Marketing API autorizzata sull'account pubblicitario
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
